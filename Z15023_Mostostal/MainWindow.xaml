<Window x:Class="Z25023_Mostostal.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Z25023_Mostostal"
        xmlns:vm="clr-namespace:Z25023_Mostostal.ViewModels"
        xmlns:controls="clr-namespace:Z25023_Mostostal.Controls" 
        WindowState="Maximized"
        mc:Ignorable="d"
        Title="MainWindow" Height="1000" Width="1900">
    <Grid>


        <Grid Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="60"/>
                <RowDefinition Height="620"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!--<StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">-->
            <Border BorderBrush="DodgerBlue" BorderThickness="0" Grid.RowSpan="2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition  />
                    </Grid.ColumnDefinitions>
                    <Rectangle x:Name="rec" Grid.Column="0" Width="15" Fill="LightSkyBlue"/>
                    <Button x:Name="serviceBn" Grid.Column="2" Height="55" Width="125" HorizontalAlignment="Center" VerticalAlignment="Center" BorderThickness="0" Background="White" Style="{StaticResource StaticButton}" Click="serviceBn_Click" >
                        <Image  Height="50" Width="120"  HorizontalAlignment="Center" VerticalAlignment="Center" Source="/Images/PRO_ZAP_logo.png" Stretch="UniformToFill"/>
                    </Button>
                </Grid>
            </Border>
            <!--</StackPanel>-->

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Label Content="Mostostal - System Zarządzania Receptami" Margin="0,0,0,0" FontSize="22" FontWeight="Bold" Foreground="DodgerBlue" />
            </StackPanel>



            <Grid Grid.Row="2" Grid.Column="0" Grid.RowSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition  />
                </Grid.ColumnDefinitions>
                
                <Rectangle x:Name="rec2" Width="15" Fill="LightSkyBlue"/>
                <Button Content="Ustawienia" Grid.ColumnSpan="2" Margin="0,0,0,0" HorizontalAlignment="Left"  VerticalAlignment="Top" Height="50" Width="200" Style="{StaticResource MenuButton}" Command="{Binding OpenSettingsCommand}" />
                <Button Content="Recepty" Grid.ColumnSpan="2" Margin="0,50,0,0" HorizontalAlignment="Left"  VerticalAlignment="Top" Height="50" Width="200" Style="{StaticResource MenuButton}" Command="{Binding OpenSettingsCommand}" />
                <Button Content="Odśwież zlecenia" Grid.ColumnSpan="2" Margin="0,620,0,0" HorizontalAlignment="Left"  VerticalAlignment="Top" Height="50" Width="200" Style="{StaticResource MenuButton}" Command="{Binding RefreshOrdersCommand}" />
            </Grid>

            <UniformGrid Grid.Row="1" Grid.Column="1" Grid.RowSpan="2" Columns="2" Rows="2" Background="#FFDFDFDF" Margin="0,0,0,0">
                <controls:PlcStatusControl DataContext="{Binding Plc1}" Margin="10,10,5,5"/>
                <controls:PlcStatusControl DataContext="{Binding Plc2}" Margin="5,10,10,5"/>
                <controls:PlcStatusControl DataContext="{Binding Plc3}" Margin="10,5,5,10"/>
                <controls:PlcStatusControl DataContext="{Binding Plc4}" Margin="5,5,10,10"/>
            </UniformGrid>




            
            <DataGrid Grid.Row="3" Grid.Column="1" ItemsSource="{Binding Orders}" 
          SelectedItem="{Binding SelectedOrder}" 
          AutoGenerateColumns="True" 
          IsReadOnly="True"
          SelectionMode="Single" Margin="0,0,0,0" Grid.RowSpan="2">
                <!--<DataGrid.Columns>
                    <DataGridTextColumn Header="Nr Zlecenia" Binding="{Binding KOLZLEC}"/>
                    <DataGridTextColumn Header="Typ" Binding="{Binding TYP}"/>
                    <DataGridTextColumn Header="Długość" Binding="{Binding DLUGOSC}"/>
                    <DataGridTextColumn Header="Szerokość" Binding="{Binding SZEROKOSC}"/>
                    <DataGridTextColumn Header="Sztuk" Binding="{Binding SZTUKPOZ}"/>
                </DataGrid.Columns>-->
            </DataGrid>

            <!--<Button Grid.Row="4" Grid.Column="1"
                Content="Wyślij Zlecenie" 
                Command="{Binding SendSelectedOrderToPlcCommand}" 
                Width="220" Height="40" 
                Margin="0,55,0,55" 
                HorizontalAlignment="Left"
                FontSize="14" FontWeight="Bold"
                Cursor="Hand"/>-->
        </Grid>



    </Grid>
</Window>
