<Window x:Class="Z25023_Mostostal.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Konfiguracja Systemu" Height="450" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Grid Background="#F0F0F0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Margin="10">

            <TabItem Header="Baza Danych SQL">
                <Grid Margin="15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Serwer (IP/Nazwa):" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,10"/>
                    <TextBox Text="{Binding Server, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Padding="4"/>

                    <TextBlock Text="Port:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,10"/>
                    <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Padding="4"/>

                    <TextBlock Text="Nazwa Bazy:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,10"/>
                    <TextBox Text="{Binding DatabaseName, UpdateSourceTrigger=PropertyChanged}" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Padding="4"/>

                    <TextBlock Text="Użytkownik:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,10"/>
                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" Padding="4"/>

                    <TextBlock Text="Nowe Hasło:" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Margin="0,10"/>
                    <PasswordBox x:Name="DbPasswordBox" PasswordChanged="DbPasswordBox_PasswordChanged" Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" Padding="4"/>

                    <TextBlock Grid.Row="5" Grid.Column="1" Text="*Pozostaw puste, aby użyć zapisanego hasła" FontSize="11" Foreground="Gray" Margin="0,5,0,0"/>

                    <TextBlock Text="Widok Zleceń:" Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Margin="0,10"/>
                    <TextBox Text="{Binding OrdersViewName, UpdateSourceTrigger=PropertyChanged}" Grid.Row="6" Grid.Column="1" VerticalAlignment="Center" Padding="4"/>

                    <Button Grid.Row="7" Grid.Column="0" Content="Testuj Połączenie" Command="{Binding TestConnectionCommand}" Width="120" Height="30"/>
                </Grid>
            </TabItem>

            <TabItem Header="Lokalna Baza (Receptury)">
                <Grid Margin="15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Serwer (IP/Nazwa):" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,10"/>
                    <TextBox Text="{Binding LocalServer, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Padding="4"/>

                    <TextBlock Text="Port:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,10"/>
                    <TextBox Text="{Binding LocalPort, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Padding="4"/>

                    <TextBlock Text="Nazwa Bazy:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,10"/>
                    <TextBox Text="{Binding LocalDatabaseName, UpdateSourceTrigger=PropertyChanged}" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Padding="4"/>

                    <TextBlock Text="Użytkownik:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,10"/>
                    <TextBox Text="{Binding LocalUsername, UpdateSourceTrigger=PropertyChanged}" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" Padding="4"/>

                    <TextBlock Text="Nowe Hasło:" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Margin="0,10"/>
                    <PasswordBox x:Name="LocalDbPasswordBox" PasswordChanged="LocalDbPasswordBox_PasswordChanged" Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" Padding="4"/>

                    <TextBlock Grid.Row="5" Grid.Column="1" Text="*Pozostaw puste, aby użyć zapisanego hasła" FontSize="11" Foreground="Gray" Margin="0,5,0,0"/>

                    <Button Grid.Row="7" Grid.Column="0" Content="Testuj Połączenie" Command="{Binding TestLocalConnectionCommand}" Width="120" Height="30" Margin="0,20,0,0"/>
                </Grid>
            </TabItem>

        </TabControl>

        <Border Grid.Row="1" Background="White" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                

                <Button Grid.Column="2" Content="Anuluj" Command="{Binding CancelCommand}" Width="80" Height="30" Margin="0,0,10,0"/>
                <Button Grid.Column="3" Content="Zapisz" Command="{Binding SaveSettingsCommand}" Width="80" Height="30" FontWeight="Bold" Background="#0078D7" Foreground="White"/>
            </Grid>
        </Border>
    </Grid>
</Window>
