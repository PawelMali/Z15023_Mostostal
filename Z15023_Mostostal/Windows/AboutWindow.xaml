<Window x:Class="Z25023_Mostostal.Windows.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Z25023_Mostostal.Windows"
        mc:Ignorable="d"
        Title="O programie" Height="560" Width="500"
        WindowStartupLocation="CenterOwner" 
        ResizeMode="NoResize" 
        WindowStyle="ToolWindow"
        Background="White"
        FontFamily="Segoe UI">

    <Window.Resources>



        <!-- Jasnoniebieski z paska po lewej stronie -->

        <SolidColorBrush x:Key="TextDark" Color="#333333"/>

        <!-- Styl dla przycisku nawiązujący do "Szczegóły zlecenia" -->
        <Style x:Key="FlatBlueButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="DodgerBlue"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="4,0,0,0"/>
            <Setter Property="BorderBrush" Value="LightSkyBlue"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="AliceBlue"/>
                                <Setter Property="BorderBrush" Value="DodgerBlue"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#E0EAF5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Zewnętrzna siatka dzieląca okno na pasek boczny i zawartość -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10"/>
            <!-- Charakterystyczny niebieski pasek na krawędzi (jak w oknie głównym) -->
            <ColumnDefinition Width="*"/>
            <!-- Główna treść -->
        </Grid.ColumnDefinitions>

        <!-- Niebieski pasek po lewej stronie -->
        <Rectangle Grid.Column="0" Fill="LightSkyBlue" VerticalAlignment="Stretch"/>

        <!-- Kontener na główną zawartość (teraz przesunięty do Kolumny 1) -->
        <Grid Grid.Column="1" Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Logo i Nagłówek -->
                <RowDefinition Height="*"/>
                <!-- Główna zawartość -->
                <RowDefinition Height="Auto"/>
                <!-- Stopka i Zamknij -->
            </Grid.RowDefinitions>

            <!-- Sekcja Górna: Logo i Tytuł -->
            <Grid Grid.Row="0" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" 
                       Source="/Images/PRO_ZAP_logo.png" 
                       Width="130" 
                       Height="55" 
                       Stretch="Uniform" 
                       HorizontalAlignment="Left" 
                       VerticalAlignment="Center" 
                       Margin="10,0,20,0"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="  Z25023 Mostostal" FontSize="18" FontWeight="Bold" Foreground="DodgerBlue"/>
                    <TextBlock Text="• Moduł komunikacyjny sterowników PLC" FontSize="14" Foreground="Gray" Margin="0,2,0,0"/>
                    <TextBlock Text="• Moduł obsługi zleceń SQL" FontSize="14" Foreground="Gray" Margin="0,2,0,0"/>
                    <TextBlock Text="• Moduł symulacji prasy" FontSize="14" Foreground="Gray" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Główna zawartość w charakterystycznej ramce -->
            <Border Grid.Row="1" BorderBrush="LightSkyBlue" BorderThickness="1" Background="White">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Pasek tytułowy ramki (podobny do "Przygotowanie płaskownika") -->
                    <Border Grid.Row="0" Background="AliceBlue" BorderBrush="LightSkyBlue" BorderThickness="0,0,0,1" Padding="10,5">
                        <TextBlock Text="Informacje o aplikacji" FontWeight="Bold" Foreground="DodgerBlue" HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Treść -->
                    <StackPanel Grid.Row="1" Margin="20,15,20,15">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Wersja oprogramowania:" Foreground="{StaticResource TextDark}" FontWeight="SemiBold"/>
                            <TextBlock x:Name="VersionText" Grid.Column="1" Text="v 1.2.0.0 (Build 2023.10)" Foreground="{StaticResource TextDark}"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Licencja:" Foreground="{StaticResource TextDark}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="Mostostal Siedlce Spółka z o.o" Foreground="{StaticResource TextDark}"/>
                        </Grid>

                        <Separator Margin="0,10,0,10" Background="LightSkyBlue"/>


                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Vertical" Grid.Column="0" Margin="0,5,0,0" >
                                <TextBlock Text="Kontakt:" Foreground="DodgerBlue" FontWeight="Bold" Margin="0,0,0,5"/>
                                <TextBlock Text="INTROL PRO-ZAP Sp. z o.o." FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextDark}"/>
                                <TextBlock Text="ul. Grabowska 47a" FontWeight="Normal" FontSize="14" Foreground="{StaticResource TextDark}"/>
                                <TextBlock Text="63-400 Ostrów Wielkopolski" FontWeight="Normal" FontSize="14" Foreground="{StaticResource TextDark}"/>
                                <TextBlock Text="Polska" FontWeight="Normal" FontSize="14" Foreground="{StaticResource TextDark}"/>
                                <TextBlock Text=" " FontWeight="Normal" FontSize="14" Foreground="{StaticResource TextDark}"/>
                                <TextBlock Text="+48 62 73 74 150" FontWeight="Normal" FontSize="14" Foreground="{StaticResource TextDark}"/>

                                <TextBlock Text="office@pro-zap.pl" Foreground="DodgerBlue" TextDecorations="Underline"/>
                                <TextBlock Text="serwis@pro-zap.pl" Foreground="DodgerBlue" TextDecorations="Underline"/>

                                <TextBlock Text=" " FontWeight="Normal" FontSize="8" Foreground="{StaticResource TextDark}"/>
                                <TextBlock>
                                    <Hyperlink NavigateUri="https://www.pro-zap.pl" RequestNavigate="Hyperlink_RequestNavigate" FontWeight="Bold" FontSize="16" Foreground="DodgerBlue" TextDecorations="Underline" Cursor="Hand">
                                        www.pro-zap.pl
                                    </Hyperlink>
                                </TextBlock>

                            </StackPanel>

                            <Image Grid.Column="1" 
                               Source="/Images/QRCode.png" 
                               Width="160" 
                               Height="160" 
                               Stretch="Uniform" 
                               HorizontalAlignment="Left" 
                               VerticalAlignment="Center" 
                               Margin="50,15,20,0"/>

                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Sekcja Dolna: Prawa autorskie i Przycisk -->
            <Grid Grid.Row="2" Margin="0,15,0,0">
                <TextBlock Text="© INTROL PRO-ZAP Sp. z o.o. Wszelkie prawa zastrzeżone." 
                           VerticalAlignment="Center" FontSize="13" Foreground="Gray"/>

                <Button Content="Zamknij" 
                        HorizontalAlignment="Right" 
                        Width="90" Height="40"
                        Style="{StaticResource FlatBlueButton}"
                        Click="BtnClose_Click"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
