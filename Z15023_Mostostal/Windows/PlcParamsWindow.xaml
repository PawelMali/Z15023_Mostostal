<Window x:Class="Z25023_Mostostal.Windows.PlcParamsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Z25023_Mostostal.Windows"
        mc:Ignorable="d"
        Title="Aktualne Parametry Maszyny" Height="700" Width="550"
        WindowStartupLocation="CenterOwner" Background="#F0F0F0">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Label Content="BIEŻĄCE NASTAWY PROCESOWE (Config)" Grid.Row="0" 
               Style="{StaticResource HeadersLabel}" HorizontalAlignment="Stretch" Height="40" Margin="0,0,0,10"/>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Parameters}" AutoGenerateColumns="False" 
                  IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow"
                  HeadersVisibility="Column" Background="White" BorderBrush="DodgerBlue" BorderThickness="1"
                  RowHeight="30" FontSize="14" AlternatingRowBackground="#F8F8F8">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nr" Binding="{Binding Index}" Width="40">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="Gray"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Opis Parametru" Binding="{Binding Name}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="5,0,0,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Wartość" Binding="{Binding Value, StringFormat=F2}" Width="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="DodgerBlue"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="2" Content="Zamknij" Width="100" Height="35" Margin="0,15,0,0"
                Style="{StaticResource StandardButton}" HorizontalAlignment="Right" IsCancel="True" Click="Close_Click"/>
    </Grid>
</Window>
